# Keep this file in server/.env after copying it.
GEMINI_API_KEY=replace_with_your_key
# Choose a text model enabled for your key in Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000
# Set only if you have a trusted reverse proxy; never set blindly.
TRUST_PROXY_HOPS=0
SESSION_TTL_MINUTES=60
MAX_SESSIONS=100
